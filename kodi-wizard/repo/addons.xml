<?xml version="1.0" encoding="UTF-8"?>
<addons>
    <addon id="plugin.program.pigeonbuild" name="Pigeon Build Wizard" version="1.0.0" provider-name="Pigeon Build Team">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
            <import addon="script.module.requests"/>
            <import addon="script.module.six"/>
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>executable</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">Pigeon Build Wizard - Fast Streaming, Zero Buffer</summary>
            <description lang="en">The ultimate Kodi build wizard optimized for Fire TV Stick and streaming devices. Features pre-configured add-ons, optimized settings, and everything you need for the perfect streaming experience.</description>
            <disclaimer lang="en">The developers of Pigeon Build do not host, create, or distribute any content. We provide a configuration tool only.</disclaimer>
            <platform>all</platform>
            <license>GPL-3.0</license>
            <website>https://github.com/mz1312/pigeonhole</website>
            <source>https://github.com/mz1312/pigeonhole</source>
            <forum></forum>
            <email></email>
            <assets>
                <icon>resources/media/icon.png</icon>
                <fanart>resources/media/fanart.png</fanart>
            </assets>
            <news>
v1.0.0 (2025-10-04)
- Initial release
- Fire TV Stick optimized builds
- Advanced settings for Fire TV, Shield, PC
- Maintenance tools (cache, thumbnails, packages)
- Full backup and restore functionality
- Popular add-on quick install
            </news>
        </extension>
    </addon>

    <addon id="repository.pigeonbuild" name="Pigeon Build Repository" version="1.0.0" provider-name="Pigeon Build Team">
        <extension point="xbmc.addon.repository" name="Pigeon Build Repository">
            <dir>
                <info compressed="false">https://raw.githubusercontent.com/mz1312/pigeonhole/main/kodi-wizard/repo/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/mz1312/pigeonhole/main/kodi-wizard/repo/addons.xml.md5</checksum>
                <datadir zip="true">https://raw.githubusercontent.com/mz1312/pigeonhole/main/kodi-wizard/repo/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary>Pigeon Build Official Repository</summary>
            <description>Official repository for Pigeon Build wizard and related add-ons. Fast streaming, zero buffer.</description>
            <disclaimer></disclaimer>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.png</fanart>
            </assets>
        </extension>
    </addon>
</addons>
